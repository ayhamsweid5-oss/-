rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /users/{id} { allow read, write: if signedIn() && id == request.auth.uid; }
    match /materials/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }
    match /stockMovements/{id} { allow read, write: if signedIn(); }
    match /contacts/{id} { allow read, write: if signedIn(); }
  }
}
